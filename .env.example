# ============================================================
# Polymarket CTF Merge Bot — Environment Template
# Salin ke `.env` dan isi sesuai kebutuhan. JANGAN commit `.env`!
# ============================================================

# --- Mode ---
# paper = simulasi (tanpa private key), live = trading nyata
MODE=paper

# --- Wallet (EOA) ---
# Untuk live mode: private key wallet EOA yang address-nya sudah
# proxy/deposit-authorized di Polymarket (harus funding wallet yang sama
# dengan WALLET_ADDRESS)
PRIVATE_KEY=
# Address wallet EOA (funder/deposit) — wajib diisi untuk live mode
WALLET_ADDRESS=0x...

# --- RPC ---
# RPC Polygon mainnet privat disarankan (Alchemy/QuickNode/Infura)
RPC_URL=https://polygon-rpc.com

# --- CLOB API credentials (dari auth flow `derive_api_key`) ---
CLOB_API_KEY=
CLOB_API_SECRET=
CLOB_API_PASSPHRASE=
CLOB_API_L2=false

# --- Strategy / Risk ---
THRESHOLD=0.995
MIN_PROFIT_USD=1.0
MIN_PROFIT_MARGIN_BPS=10
MAX_SIZE_PER_TRADE=500
MAX_DAILY_LOSS=100
COOLDOWN_SECONDS=5
MAX_TRADES_PER_MINUTE=10
RESERVE_GAS_USD=2.0
POLL_INTERVAL=30

# --- Execution ---
# FOK (default, full-fill-or-kill) atau IOC (partial fill diizinkan)
ORDER_TYPE=FOK
EXCESS_MODE=cancel
MERGE_MODE=adapter
AUTO_WRAP_USDCE=false
TX_TIMEOUT_SECONDS=120

# --- Scanner ---
WATCHLIST_MODE=explicit
# Path relatif terhadap root proyek
WATCHLIST_PATH=config/markets.watchlist.json
AUTO_DISCOVER=true
AUTO_DISCOVER_MIN_LIQUIDITY=5000
AUTO_DISCOVER_MIN_VOLUME_24H=1000
AUTO_DISCOVER_ACTIVE_ONLY=true

# --- Fee (bps override, opsional) ---
# Isi bila scanner tidak berhasil fetch fee rate otomatis.com
FEE_RATE_BPS_OVERRIDE=

# --- Gas (opsional: harga MATIC dalam USD) ---
MATIC_USD_PRICE=

# --- Telegram notifier (opsional) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_RATE_LIMIT_PER_MIN=20

# --- Logging ---
LOG_LEVEL=INFO
LOG_DIR=logs
# --- CTF / Collateral (wajib untuk live mode) ---
# Address kontrak CTF Exchange, NegRiskAdapter, dan WrapperUSDC di Polygon mainnet.
# Nilai ini sudah disetel berdasarkan alamat resmi Polygon mainnet CTF V2.
CTF_EXCHANGE_ADDRESS=0xE111180000d2663C0091e4f400237545B87B996B
CTF_CONDITION_TOKENS=0x4D97DCd97eC945f40cF65F87097ACe5EA0476045
CTF_COLLATERAL_ADAPTER_ADDRESS=0xAdA100Db00Ca00073811820692005400218FcE1f
NEG_RISK_EXCHANGE_ADDRESS=0xe2222d279d744050d28e00520010520000310F59
NEG_RISK_ADAPTER_ADDRESS=0xd91E80cF2E7be2e162c6513ceD06f1dD0dA35296
WRAPPER_USDC_ADDRESS=0xC011a7E12a19f7B1f670d46F03B03f3342E82DFB  # pUSD proxy

# USD.e address for wrap/unwrap (6 decimals)
USDCE_ADDRESS=0x2791Bca1f2de4661ED88A30C99A7a9449Aa84174

# --- Telegram ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
